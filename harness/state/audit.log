        f.write("x = 1\n")
    repo.index.add(["a.py"])
    repo.index.commit("init")
    repo.create_head("feature-x")

    observer = GitObserver(temp_git_repo)
    branches = observer.list_local_branches()
    assert observer.get_active_branch() in branches
