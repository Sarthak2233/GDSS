# ==============================================================================
# .gdss.yml - GDSS Semantic Repository Intelligence Configuration
# ==============================================================================
# IMPORTANT: Name this file '.gdss.yml' (or '.gdss.yaml') in your REPOSITORY ROOT.
# ⚠️ DO NOT name it '.gdss-radar.yml' (the engine looks specifically for .gdss.yml).
#
# Both local developer CLI operations and the GitHub Actions CI Radar will
# automatically load these settings as the single source of truth.
# ==============================================================================

# Configuration schema version (currently 1)
version: 1

# ------------------------------------------------------------------------------
# 1. AI Convergence & PR Collision Radar
# ------------------------------------------------------------------------------
radar:
  # LLM Provider:
  #   - "openrouter" (Recommended free tier & multi-model gateway via OPENROUTER_API_KEY)
  #   - "deepseek" (uses DEEPSEEK_API_KEY, defaults base_url to https://api.deepseek.com/v1)
  #   - "groq" (uses GROQ_API_KEY, defaults base_url to https://api.groq.com/openai/v1)
  #   - "together" (uses TOGETHER_API_KEY, defaults base_url to https://api.together.xyz/v1)
  #   - "mistral" (uses MISTRAL_API_KEY, defaults base_url to https://api.mistral.ai/v1)
  #   - "anthropic" (uses ANTHROPIC_API_KEY)
  #   - "openai" (uses OPENAI_API_KEY)
  #   - "azure" (uses AZURE_OPENAI_API_KEY or AZURE_AI_API_KEY)
  #   - "copilot" (GitHub Copilot CLI in CI via GITHUB_TOKEN & copilot-requests: write)
  #   - "ollama" / "vllm" / "lm-studio" / "localai" (keyless offline local inference)
  #   - "openai-compatible" (generic OpenAI protocol with custom base_url)
  provider: "openrouter"

  # The LLM model used for semantic patch reconciliation & contract synthesis.
  # Popular options:
  #   - "openrouter/free" (OpenRouter automated zero-cost router - default)
  #   - "gpt-4o-mini" / "gpt-4o" (Microsoft Azure AI Foundry, OpenAI)
  #   - "deepseek-chat" (DeepSeek V3 / R1)
  #   - "claude-3-5-sonnet-20241022" (OpenRouter / Anthropic)
  #   - "llama-3.3-70b-versatile" (Groq / OpenRouter)
  #   - "qwen2.5-coder:7b" (Local Ollama / vLLM)
  model: "openrouter/free"

  # Optional environment variable name for API inference authentication:
  # By default, GDSS auto-discovers keys from your project root '.env' matching the provider:
  #   - provider: "openrouter" -> checks OPENROUTER_API_KEY
  #   - provider: "deepseek"   -> checks DEEPSEEK_API_KEY
  #   - provider: "groq"       -> checks GROQ_API_KEY
  #   - provider: "together"   -> checks TOGETHER_API_KEY
  #   - provider: "mistral"    -> checks MISTRAL_API_KEY
  #   - provider: "anthropic"  -> checks ANTHROPIC_API_KEY
  #   - provider: "openai"     -> checks OPENAI_API_KEY
  #   - provider: "azure"      -> checks AZURE_OPENAI_API_KEY or AZURE_AI_API_KEY
  #   - provider: "copilot"    -> checks GITHUB_TOKEN
  #   - provider: "ollama" / "vllm" / "lm-studio" / "localai" -> Keyless ($0 local offline inference)
  # Universal override: Setting GDSS_API_KEY in .env always applies to GDSS regardless of other keys.
  # If your team or CI runner uses a custom secret name, declare it here:
  # api_key_env: "CORP_LLM_SECRET"

  # Custom API base URL (optional, for self-hosted LLM endpoints or OpenAI-compatible proxies):
  # base_url: "https://openrouter.ai/api/v1"

  # [RECOMMENDED BEST PRACTICE] Explicit Context Window (in tokens)
  # ----------------------------------------------------------------------------
  # Declaring context_window explicitly guarantees that GDSS allocates up to 45%
  # of the context window (up to 96,000 characters) for rich code symbol AST
  # definitions, caller/callee graphs, and commit trajectories.
  #
  # If omitted, GDSS uses heuristic fallbacks which default conservatively to 16k,
  # causing unnecessary ellipsis condensation (/* ... N lines condensed ... */).
  #
  # Reference sizes:
  #   gemini-1.5-pro / 2.0-pro: 2000000
  #   gemini-1.5-flash: 1000000
  #   claude-3-5-sonnet: 200000
  #   gpt-4o: 128000
  #   gpt-4o-mini: 128000
  #   llama-3.3-70b: 128000
  #   deepseek-chat: 64000
  context_window: 128000

  # Collision risk sensitivity threshold (0.0 to 1.0).
  # Collisions with severity >= risk_threshold will be flagged in the PR report.
  #   0.05 = Aggressive (flags subtle cross-file caller dependencies)
  #   0.10 = Standard recommended balance (default)
  #   0.25 = Strict (flags only direct signature changes & severe AST overlaps)
  #   0.80 = Critical only (flags only outright contradictory mutations)
  risk_threshold: 0.1

  # Maximum agentic self-correction iterations in the ephemeral sandbox.
  # When GDSS generates a candidate patch, it compiles and runs tests in an
  # ephemeral Git worktree. If tests fail, it feeds the compiler error trace back
  # to the model to refine the patch up to max_refinements times.
  max_refinements: 2

  # Maximum concurrent worker threads for parallel conflict drafting.
  # Default: 4
  concurrency_limit: 4

  # Context preservation policy:
  #   - "lossless" (default: preserves 100% of code tokens without aggressive truncation)
  #   - "ast_minimal" (signatures and symbol bodies only)
  #   - "off" (raw context)
  condensation: "lossless"

  # Branch protection gating:
  # If true, the CI job exits with code 1 when severe collisions are detected.
  # If false, the CI job remains green and posts an informational sticky report.
  fail_on_collision: false

# ------------------------------------------------------------------------------
# 2. Ephemeral Sandbox Validation
# ------------------------------------------------------------------------------
# GDSS validates candidate reconciliation patches in isolated temporary Git
# worktrees before human review. Configure your project's validation commands:
validation:
  # Validation mode:
  #   - "targeted" (default): filters tests and typechecking strictly to changed files or targeted test files
  #   - "full_suite": runs the full unconstrained test suite in the ephemeral worktree
  mode: "targeted"

  # Worktree dependency optimization:
  # When true (default), GDSS symlinks parent node_modules, .venv, and vendor directories
  # into ephemeral sandbox worktrees if package manifests are unmodified, saving minutes of build time.
  symlink_dependencies: true

  # Optional package installation command executed inside the ephemeral worktree
  # prior to static typechecking and tests (e.g. "npm ci", "poetry install", "pip install -e .").
  # install_command: "npm ci"

  # Multi-language syntax compilation or fast syntax linter command (Gate 1).
  # Use {file} placeholder for targeted changed files.
  # If omitted, GDSS runs in-process Tree-sitter AST validation across 9+ languages.
  # Examples:
  #   Python:        "python3 -m py_compile {file}"
  #   TypeScript/JS: "npx eslint --no-ignore {file}"
  #   Go:            "go vet {file}"
  # syntax_command: "python3 -m py_compile {file}"

  # Targeted test runner command.
  # Use {test_file} placeholder for targeted test execution.
  # Examples:
  #   TypeScript/JS: "npm test -- {test_file}" or "pnpm test {test_file}"
  #   Python:        "pytest {test_file}"
  #   Go:            "go test -v ./{test_file}/..."
  #   Rust:          "cargo test --test {test_file}"
  test_command: "npm test -- {test_file}"

  # Static type checker or linter command.
  # Use {file} placeholder for targeted file checking.
  # Examples:
  #   TypeScript:    "npx tsc --noEmit"
  #   Python:        "mypy {file}"
  #   Go:            "golangci-lint run"
  #   Rust:          "cargo check"
  typecheck_command: "npx tsc --noEmit"

  # Maximum duration in seconds allowed for validation runs in the sandbox.
  timeout_seconds: 60

  # Test Anti-Gaming Invariant Policy:
  # When true (default), strictly forbids the convergence engine from deleting or removing
  # any test assertions to make a failing suite pass. If assertions are deleted, the patch fails Gate 1.
  anti_gaming_strict: true

  # Allow Adapting Call Sites in Tests:
  # When true (default), allows the convergence assistant to update test call sites to match
  # new function signatures (e.g. adding a new required parameter) without triggering an anti-gaming penalty.
  allow_callsite_updates: true

# ------------------------------------------------------------------------------
# 3. Deterministic Semantic Impact Closure (SIC) Engine
# ------------------------------------------------------------------------------
# When a conflict occurs at symbol C_0, GDSS deterministically expands the blast radius
# across the dependency call graph to capture affected callers, contracts, and tests.
#
# TWO-TIER RESOLUTION STRATEGY:
#   Tier 1 (Explicit Configuration): Glob patterns defined here take primary precedence.
#   Tier 2 (Final Resort / Built-in Heuristics): If omitted or unmatched, GDSS falls back
#          to automatic multi-language indicators (supporting Python, TS/JS, Go, Rust, C#, Java, C/C++).
impact_closure:
  # Maximum depth of transitive caller traversal across the reverse dependency graph (default: 2 hops).
  # Hop 0 = direct conflict symbol, Hop 1 = direct callers, Hop 2 = transitive callers.
  max_hops: 2

  # Minimum relevance edge-weight threshold for transitive caller propagation (0.0 to 1.0, default: 0.70).
  # Higher values prune distant, weak caller edges to keep convergence prompts focused.
  relevance_threshold: 0.70

  # Context token budget ceiling for semantic closure packaging (default: 4000 tokens).
  # When closure exceeds this limit, GDSS applies Knapsack priority pruning:
  # Hop 0 > Tests > Direct Callers > Transitive Callers (pruned lowest-weight first).
  token_budget: 4000

  # Explicit glob patterns for test suites (Tier 1 Primary Authority).
  # Matches take precedence over built-in filename heuristics.
  # If omitted, GDSS automatically detects test files via built-in patterns (*.test.*, *_test.*, etc.).
  test_patterns:
    - "tests/**"
    - "spec/**"
    - "e2e/**/*.spec.ts"
    - "test-harness/**"

  # Explicit glob patterns for API schemas, contracts, and interface definitions (Tier 1 Primary Authority).
  # Matches take precedence over built-in contract indicators.
  # If omitted, GDSS automatically detects contracts via extensions (.proto, .graphql, .openapi.yaml, .sql, .prisma)
  # and architectural indicators (controllers, routes, schemas, repositories, C# interfaces).
  contract_patterns:
    - "proto/**"
    - "schemas/**/*.json"
    - "src/contracts/**"
    - "internal/interfaces/**"

# ------------------------------------------------------------------------------
# 4. Branch Hierarchy & Flight Radar Boundaries
# ------------------------------------------------------------------------------
hierarchy:
  # Primary reference branch (attractor base)
  reference_branch: "main"

  # Precedence chain for multi-stage branch landing
  priority_chain:
    - "main"
    - "develop"

  # [CRITICAL] When true, only pull requests targeting the SAME base branch
  # (e.g. main) are audited against each other. Highly recommended for production
  # to eliminate noisy false alarms against unrelated maintenance or release branches.
  same_base_only: true

  # Glob patterns of branches to include in collision auditing (optional)
  include:
    - "feature/*"
    - "fix/*"

  # Glob patterns of branches to exclude from radar auditing
  exclude:
    - "dependabot/*"
    - "renovate/*"
    - "spike/*"
    - "release/*"

  # Specific base branches that activate collision radar audits
  target_bases:
    - "main"
    - "develop"

# ------------------------------------------------------------------------------
# 5. AST Symbol & Path Filtering
# ------------------------------------------------------------------------------
ast:
  # Additional file extensions to track for AST and semantic analysis
  additional_extensions:
    - ".vue"
    - ".svelte"
    - ".sol"

  # File paths to exclude from AST symbol parsing and collision analysis
  exclude_patterns:
    - "node_modules/**"
    - "dist/**"
    - "build/**"
    - "vendor/**"
    - ".venv/**"
    - "*.min.js"
    - "coverage/**"

# ------------------------------------------------------------------------------
# 6. Database Migration Reducer (Universal Multi-Stack DAG Intelligence)
# ------------------------------------------------------------------------------
migrations:
  # Framework hint (optional):
  #   - "alembic", "django", "prisma", "drizzle", "flyway", "rails", "knex",
  #     "typeorm", "sequelize", "goose", "golang-migrate", "liquibase", "atlas", "custom"
  # When omitted, GDSS uses universal timestamp/sequence pattern matching.
  # framework: "alembic"

  # Path glob patterns to track for database migration split-heads
  paths:
    - "migrations/**"
    - "alembic/versions/**"
    - "db/migrate/**"
    - "prisma/migrations/**"

