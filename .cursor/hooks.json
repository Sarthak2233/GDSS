{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/block-dangerous-git.sh",
        "matcher": "git",
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/run-fast-sensors.sh",
        "matcher": "Write"
      }
    ],
    "afterShellExecution": [
      {
        "command": ".cursor/hooks/audit-log.sh"
      }
    ]
  }
}
