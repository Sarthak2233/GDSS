from pathlib import Path

def annotate(path, substrings):
    p = Path(path)
    lines = p.read_text().splitlines(True)
    out = []
    for line in lines:
        if 'dsa:ignore' not in line and any(s in line for s in substrings):
            if line.endswith('\n'):
                line = line[:-1] + '  # dsa:ignore\n'
            else:
                line += '  # dsa:ignore'
        out.append(line)
    p.write_text(''.join(out))

