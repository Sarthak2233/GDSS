- Result: ALL LAYERS GREEN (exit 0)

---
'''
path = Path('harness/state/progress.md')
old = path.read_text()
# keep body after first --- separator of original if present
if old.startswith('# GDSS Progress Log'):
    # replace header and prepend entry body after first block
    rest = old.split('---', 1)[1] if '---' in old else '\n' + old
    # entry already includes header + first ---
    # strip duplicate header from entry when merging: write entry + old after first entry's trailing ---
    parts = entry.rstrip() + '\n' + rest.lstrip('\n')
