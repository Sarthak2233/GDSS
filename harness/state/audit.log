from pathlib import Path
path = Path("gdss/core/ast_parser.py")
lines = path.read_text().splitlines(True)
out = []
in_parse = False
for i, line in enumerate(lines):
    if "def _parse_python(" in line or "def _parse_js_ts(" in line:
        in_parse = True
    elif in_parse and line.startswith("    def ") and "_parse_" not in line:
        in_parse = False
    if in_parse:
        # replace bare , content) and (content, and , content, used as arg
        # avoid replacing content_bytes
        newline = line
        # replace argument uses of content that aren't content_bytes
        import re
        newline = re.sub(r'(?<![\w])content(?!_bytes)', 'content_bytes', newline)
        # but don't rename the parameter declaration which is already content_bytes
        out.append(newline)
    else:
        out.append(line)
path.write_text(''.join(out))
print('done')
# verify leftover bare content in parse methods
text = path.read_text()
import re
# show lines with content that aren't content_bytes or comments about content
