from pathlib import Path

def ignore_calls(path, markers):
    p = Path(path)
    lines = p.read_text().splitlines(True)
    out = []
    for line in lines:
        stripped = line.lstrip()
        if any(m in line for m in markers) and 'dsa:ignore' not in line and stripped and not stripped.startswith('#'):
            # add ignore before newline
            if line.endswith('\n'):
                line = line[:-1] + '  # dsa:ignore\n'
            else:
                line = line + '  # dsa:ignore'
        out.append(line)
    p.write_text(''.join(out))

ignore_calls('gdss/cli/start.py', [
    'self.observer.get_file_content_at_commit("HEAD", f)',
    'self.parser.parse_file(f, head_content)',
